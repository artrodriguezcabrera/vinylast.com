---
import { site } from "../../lib/site";
import { isLanesCurrent, lanesHref, lanesNav } from "../../lib/lanes";

interface Props {
  currentPath: string;
  transparent?: boolean;
}

const { currentPath, transparent = false } = Astro.props;
const headerClass = transparent
  ? "header-area haeder-default header--transparent black-logo-version ptb_lg--40 ptb_md--40 ptb_sm--30"
  : "header-area haeder-default black-logo-version ptb_lg--40 ptb_md--40 ptb_sm--30";
---

<header class={headerClass}>
  <div class="header-wrapper container">
    <div class="row align-items-center">
      <div class="col-xl-2 col-lg-6 col-md-6 col-sm-6 col-6">
        <div class="logo">
          <a href={lanesHref("/")}>
            <img src="/images/vinylast-logo.png" alt={site.name} width="180" height="59" />
          </a>
        </div>
      </div>
      <div class="col-xl-9 d-none d-xl-block">
        <nav class="mainmenu__nav" aria-label="Primary">
          <ul class="primary-menu megamenu-wrapper">
            {
              lanesNav.map((item) => (
                <li class:list={[{ "is-current": isLanesCurrent(currentPath, item.href) }]}>
                  <a href={item.href} aria-current={isLanesCurrent(currentPath, item.href) ? "page" : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
      <div class="col-xl-1 col-lg-6 col-md-6 col-sm-6 col-6">
        <div class="header-icon d-flex justify-content-end text-right">
          <a class="hamburger-trigger d-block d-xl-none" href="#lanes-menu" aria-label="Open menu">
            <i class="fa fa-bars"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<div class="hamburger-area" id="lanes-menu">
  <div class="btn-close-search">
    <button type="button" aria-label="Close menu">
      <i class="fa fa-times" aria-hidden="true"></i>
    </button>
  </div>
  <ul class="menu-primary-menu-1 responsive-manu d-block d-xl-none">
    {
      lanesNav.map((item) => (
        <li class:list={[{ "is-current": isLanesCurrent(currentPath, item.href) }]}>
          <a href={item.href}>{item.label}</a>
        </li>
      ))
    }
  </ul>
</div>
