---
import { site } from "../../lib/site";
import { lanesHref, lanesNav } from "../../lib/lanes";

const year = new Date().getFullYear();
---

<footer class="footer-area bg-color plr--100 plr_lg--40 plr_md--30 plr_sm--30 clearfix" data-bg-color="#f4f8fa">
  <div class="footer-top ptb--80">
    <div class="row">
      <div class="col-lg-4 col-md-6 col-12">
        <div class="footer-widget">
          <div class="logo">
            <a href={lanesHref("/")}>
              <img src="/images/vinylast-logo.png" alt={site.name} width="180" height="59" />
            </a>
          </div>
          <div class="inner">
            <p>{site.description}</p>
          </div>
        </div>
      </div>
      <div class="col-lg-4 col-md-6 col-12 mt_mobile--40">
        <div class="footer-widget">
          <h5 class="title">Navigate</h5>
          <div class="inner">
            <ul class="ft-link">
              {lanesNav.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </div>
        </div>
      </div>
      <div class="col-lg-4 col-md-6 col-12 mt_md--40 mt_sm--40">
        <div class="footer-widget">
          <h5 class="title">Contact</h5>
          <div class="inner">
            <ul class="ft-link">
              <li><a href={site.phoneHref}>{site.phone}</a></li>
              <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
              <li><a href={site.mapsUrl}>{site.address}</a></li>
              <li>{site.spanish}</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="copyright-area">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <div class="copyright-inner ptb--25 text-center">
            <p class="mb--10">&copy; {year} {site.name}. Family-owned in Lakewood, NJ since {site.founded}.</p>
            <p class="footer-switch mb--0">
              <a href="/">View this catalog in the other design</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
