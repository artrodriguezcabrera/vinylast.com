---
import type { Product } from "../lib/types";

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<a class="card card-product" href={`/products/${product.slug}`} data-category={product.category?.slug || "all"}>
  <div class:list={["card-media", { "is-placeholder": !product.hero }]}>
    {
      product.hero ? (
        <img src={product.hero.url} alt={product.hero.alt} width={product.hero.width} height={product.hero.height} />
      ) : (
        <span>{product.category?.name || "Product"}</span>
      )
    }
  </div>
  <div class="card-body">
    <div class="card-panel">
      <h3>{product.name}</h3>
      <span class="card-link">
        View product
        <span class="card-chevrons" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </span>
    </div>
  </div>
</a>
