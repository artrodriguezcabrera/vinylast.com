---
import { nav, site, isCurrentPath } from "../lib/site";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<div class="util util-bar">
  <div class="wrap util-inner">
    <div class="util-links">
      <a href={site.phoneHref}>
        <svg class="util-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path d="M6.6 3.8c.4-.4 1-.5 1.5-.3l2.3 1c.5.2.8.7.8 1.3v2.2c0 .4-.2.8-.5 1-.8.6-1.2 1.5-1 2.4.4 1.8 1.8 3.2 3.6 3.6.9.2 1.8-.2 2.4-1 .2-.3.6-.5 1-.5h2.2c.6 0 1.1.3 1.3.8l1 2.3c.2.5.1 1.1-.3 1.5l-1.1 1.1c-.4.4-1 .6-1.5.5-4.2-.5-8.1-2.8-10.8-5.5S4.9 8.8 4.4 4.6c-.1-.5.1-1.1.5-1.5z"></path>
        </svg>
        {site.phone}
      </a>
      <a href={`mailto:${site.email}`}>
        <svg class="util-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="m3 7 9 6 9-6"></path>
        </svg>
        {site.email}
      </a>
    </div>
    <span class="util-es">{site.spanish}</span>
  </div>
</div>

<header class="site-header">
  <div class="wrap header-inner">
    <a class="logo-link" href="/" aria-label={`${site.name} home`}>
      <img src="/images/vinylast-logo.png" alt={site.name} width="2001" height="651" />
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <nav class="nav" id="site-nav">
      <ul class="nav-list">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class={item.href === "/contact" ? "nav-cta" : undefined}
                aria-current={isCurrentPath(currentPath, item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="util nav-util">
        <div class="util-inner">
          <div class="util-links">
            <a href={site.phoneHref}>
              <svg class="util-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path d="M6.6 3.8c.4-.4 1-.5 1.5-.3l2.3 1c.5.2.8.7.8 1.3v2.2c0 .4-.2.8-.5 1-.8.6-1.2 1.5-1 2.4.4 1.8 1.8 3.2 3.6 3.6.9.2 1.8-.2 2.4-1 .2-.3.6-.5 1-.5h2.2c.6 0 1.1.3 1.3.8l1 2.3c.2.5.1 1.1-.3 1.5l-1.1 1.1c-.4.4-1 .6-1.5.5-4.2-.5-8.1-2.8-10.8-5.5S4.9 8.8 4.4 4.6c-.1-.5.1-1.1.5-1.5z"></path>
              </svg>
              {site.phone}
            </a>
            <a href={`mailto:${site.email}`}>
              <svg class="util-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                <path d="m3 7 9 6 9-6"></path>
              </svg>
              {site.email}
            </a>
          </div>
          <span class="util-es">{site.spanish}</span>
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector(".nav-toggle");
  const nav = document.querySelector("#site-nav");
  toggle?.addEventListener("click", () => {
    const open = nav?.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  });
</script>
