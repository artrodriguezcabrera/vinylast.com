---
interface Props {
  title: string;
  text: string;
  href?: string;
  cta?: string;
}

const { title, text, href = "/contact", cta = "Contact us" } = Astro.props;
---

<section class="cta-band">
  <div class="wrap">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <a class="btn btn-ghost" href={href}>{cta}</a>
  </div>
</section>
