---
interface Props {
  title: string;
  items: string[];
}

const { title, items } = Astro.props;
---

<article class="sourcing-row">
  <div class="sourcing-row-media" aria-hidden="true"></div>
  <div class="prose">
    <h2>{title}</h2>
    <ol>
      {items.map((item) => <li>{item}</li>)}
    </ol>
  </div>
</article>
