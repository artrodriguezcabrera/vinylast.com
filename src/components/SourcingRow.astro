---
interface Props {
  title: string;
  items: string[];
  image: string;
  imageAlt: string;
  imagePosition?: string;
}

const { title, items, image, imageAlt, imagePosition } = Astro.props;
---

<article class="sourcing-row">
  <div class="sourcing-row-media">
    <img src={image} alt={imageAlt} style={imagePosition ? `object-position: ${imagePosition}` : undefined} />
  </div>
  <div class="prose">
    <h2>{title}</h2>
    <ul>
      {items.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</article>
