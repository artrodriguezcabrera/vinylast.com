---
import Layout from "../../layouts/Layout.astro";
import { getResources } from "../../lib/contentful";
import { site } from "../../lib/site";
import { resourceProductLines } from "../../lib/types";

const resources = await getResources();
const knownLines = new Set<string>(resourceProductLines);
const extraLines = [
  ...new Set(resources.map((resource) => resource.productLine).filter((line) => line && !knownLines.has(line))),
];
const groups = [...resourceProductLines, ...extraLines]
  .map((name) => ({
    name,
    resources: resources.filter((resource) => resource.productLine === name),
  }))
  .filter((group) => group.resources.length > 0);
---

<Layout
  title="Resources"
  description="Catalogs, installation guides, warranties, and maintenance documents from Vinylast Inc."
  currentPath="/resources"
>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Downloads</p>
      <h1>Resources</h1>
      <p>Catalogs, installation guides, warranties, and maintenance documents.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="filters" role="toolbar" aria-label="Filter resources">
        <button class="filter-btn" type="button" data-filter="all" aria-pressed="true">
          All
        </button>
        {
          groups.map((group) => (
            <button class="filter-btn" type="button" data-filter={group.name} aria-pressed="false">
              {group.name}
            </button>
          ))
        }
        <button class="filter-btn" type="button" data-filter="testing-reports" aria-pressed="false">
          Testing Reports
        </button>
      </div>
      <div id="resource-grid">
        {
          groups.map((group) => (
            <section class="product-group" data-category={group.name}>
              <h2>{group.name}</h2>
              <div class="cards">
                  {group.resources.map((resource) => (
                    <a
                      class="card"
                      href={resource.file?.url || `/resources/${resource.slug}`}
                      target={resource.file ? "_blank" : undefined}
                      rel={resource.file ? "noopener noreferrer" : undefined}
                    >
                      {
                        resource.thumbnail && (
                          <div class="card-media is-document">
                            <img src={resource.thumbnail.url} alt={resource.thumbnail.alt} />
                          </div>
                        )
                      }
                      <div class="card-body">
                        <h3>{resource.title}</h3>
                        <span class="card-link card-action">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                            <path d="M12 3v12"></path>
                            <path d="m7 11 5 5 5-5"></path>
                            <path d="M5 21h14"></path>
                          </svg>
                          {resource.file ? "Download PDF" : "View resource"}
                          {resource.file && <span class="visually-hidden"> (opens in a new tab)</span>}
                        </span>
                      </div>
                    </a>
                  ))}
                </div>
            </section>
          ))
        }
      </div>
      <section class="testing-reports" data-category="testing-reports" aria-labelledby="testing-reports-heading">
        <h2 id="testing-reports-heading">Testing Reports Available</h2>
        <div class="prose">
          <p>
            Some building departments may require testing reports or compliance letters for different products and
            applications. All Vinylast Inc. products are third-party tested through Intertek. Please submit the
            following information, and we will get you the reports you need.
          </p>
          <ol>
            <li>Product name</li>
            <li>Application (residential or commercial), and whether IRC or IBC codes apply</li>
            <li>State and county of installation</li>
            <li>Information about the specific type of installation for the product</li>
          </ol>
          <p>
            Please submit this information and any questions to <a href={`mailto:${site.email}`}>{site.email}</a>.
            Upon receipt, we will review your request and reply with the corresponding answers, testing reports, and
            installation recommendations for your application.
          </p>
        </div>
      </section>
    </div>
  </section>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const groups = document.querySelectorAll<HTMLElement>(".product-group, .testing-reports");

  function applyFilter(filter: string) {
    const next = filter || "all";
    buttons.forEach((item) => {
      item.setAttribute("aria-pressed", item.dataset.filter === next ? "true" : "false");
    });
    groups.forEach((group) => {
      const category = group.dataset.category || "all";
      group.hidden = !(next === "all" || category === next);
    });

    const url = new URL(window.location.href);
    if (next === "all") url.searchParams.delete("category");
    else url.searchParams.set("category", next);
    history.replaceState({}, "", url);
  }

  const initial = new URLSearchParams(window.location.search).get("category") || "all";
  applyFilter(initial);

  buttons.forEach((button) => {
    button.addEventListener("click", () => applyFilter(button.dataset.filter || "all"));
  });
</script>
