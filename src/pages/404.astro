---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found" description="That page is not on vinylast.com." currentPath="/404">
  <section class="section">
    <div class="wrap empty">
      <h1>Page not found</h1>
      <p>The page you asked for is not here. Head back to products or contact the office.</p>
      <div class="btn-row" style="justify-content: center">
        <a class="btn btn-primary" href="/">Home</a>
        <a class="btn btn-outline" href="/products">Products</a>
        <a class="btn btn-outline" href="/contact">Contact</a>
      </div>
    </div>
  </section>
</Layout>
