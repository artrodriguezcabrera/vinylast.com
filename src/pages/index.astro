---
import Layout from "../layouts/Layout.astro";
import CategoryCard from "../components/CategoryCard.astro";
import CtaBand from "../components/CtaBand.astro";
import { getProducts } from "../lib/contentful";
import { site } from "../lib/site";

const homeCategorySlugs = [
  "vinyl-railing",
  "vinyl-fencing",
  "pergola-and-shower-enclosure",
  "accessories",
  "windows-and-doors",
] as const;
const products = await getProducts();
const categoryCards = homeCategorySlugs.flatMap((slug) => {
  const product = products.find((item) => item.category?.slug === slug);
  if (!product?.category) return [];
  return [
    {
      name: product.category.name,
      slug: product.category.slug,
      image: product.hero,
    },
  ];
});
const heroSlides = [
  {
    url: "/images/products/t-rail/vinyl-railing-with-t-rail-top-03.jpg",
    alt: "White vinyl T-Rail on a two-story porch",
    title: "Enduring Strength",
    text: "For safety and peace of mind",
  },
  {
    url: "/images/products/keylargo/imperial-vinyl-yard-fence-5.jpg",
    alt: "Keylargo closed picket vinyl fence",
    title: "Endless Styles",
    text: "Offers quality and value",
  },
  {
    url: "/images/products/ranch-rail/2-rail-post-rail-vinyl-fence-3.jpg",
    alt: "Ranch Rail post-and-rail vinyl fence",
    title: "Lasting Beauty",
    text: "Where performance meets style",
  },
  {
    url: "/images/products/pergola/1-4.jpg",
    alt: "Vinyl pergola over an outdoor living space",
    title: "Make It Yours",
    text: "With custom designs and colors",
  },
];
---

<Layout title={site.name} description={site.description} currentPath="/">
  <section class="hero" aria-roledescription="carousel" aria-label="Product photos">
    <div class="hero-viewport">
      <div class="hero-track" id="hero-track">
        {
          [...heroSlides, heroSlides[0]].map((slide, index) => (
            <div
              class="hero-slide"
              style={`background-image: url('${slide.url}')`}
              role="img"
              aria-label={slide.alt}
              aria-hidden={index === 0 ? undefined : "true"}
            />
          ))
        }
      </div>
    </div>
    <div class="hero-overlay"></div>
    <div class="wrap hero-copy">
      <p class="eyebrow">Since 1974 · Lakewood, NJ</p>
      <h1 id="hero-title">{heroSlides[0].title}</h1>
      <p id="hero-text">{heroSlides[0].text}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/products">View products</a>
        <a class="btn btn-ghost" href="/contact">Contact us</a>
      </div>
    </div>
    <div class="hero-dots" role="tablist" aria-label="Hero slides">
      {
        heroSlides.map((slide, index) => (
          <button
            type="button"
            class="hero-dot"
            data-slide={index}
            aria-label={`Show photo ${index + 1}: ${slide.alt}`}
            aria-selected={index === 0 ? "true" : "false"}
          />
        ))
      }
    </div>
  </section>

  <section class="trust">
    <div class="wrap trust-grid">
      <div class="trust-item">
        <strong>Since 1974</strong>
        <span>Family-owned &amp; operated</span>
      </div>
      <div class="trust-item">
        <strong>Customer supply</strong>
        <span>Railing, fencing, and more</span>
      </div>
      <div class="trust-item">
        <strong>Code-minded</strong>
        <span>Tested structural products</span>
      </div>
      <div class="trust-item">
        <strong>{site.spanish}</strong>
        <span>Call {site.phone}</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <!--
      <div class="section-head">
        <div>
          <h2>Products</h2>
          <p>Straightforward product pages with specs, photos, and downloads — made for the jobsite, not a brochure.</p>
        </div>
        <a class="btn btn-outline" href="/products">All products</a>
      </div>
      -->
      <div class="cards">
        {
          categoryCards.map((category) => (
            <CategoryCard name={category.name} slug={category.slug} image={category.image} />
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    title="Resources"
    text={`Installation guides, spec sheets, and warranties. Download what you need and get back to work.`}
    href="/resources"
    cta="View Resources"
  />
</Layout>

<script define:vars={{ slideCopy: heroSlides.map((s) => ({ title: s.title, text: s.text })) }}>
  const INTERVAL_MS = 6000;
  const track = document.querySelector("#hero-track");
  const titleEl = document.querySelector("#hero-title");
  const textEl = document.querySelector("#hero-text");
  const dots = [...document.querySelectorAll(".hero-dot")];
  const count = dots.length;

  if (track && count > 1 && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const slideTrack = track;
    let index = 0;
    let timer = 0;

    function setDots(active) {
      dots.forEach((dot, i) => {
        dot.setAttribute("aria-selected", i === active ? "true" : "false");
      });
    }

    function setCopy(active) {
      const slide = slideCopy[active];
      if (!slide || !titleEl || !textEl) return;
      titleEl.textContent = slide.title;
      textEl.textContent = slide.text;
    }

    function goTo(next, animate = true) {
      index = next;
      slideTrack.style.transition = animate ? "transform 0.85s cubic-bezier(0.22, 1, 0.36, 1)" : "none";
      slideTrack.style.transform = `translateX(-${index * 100}%)`;
      if (!animate) void slideTrack.offsetWidth;
      const active = index % count;
      setDots(active);
      setCopy(active);
    }

    function advance() {
      goTo(index + 1);
    }

    slideTrack.addEventListener("transitionend", () => {
      if (index < count) return;
      goTo(0, false);
    });

    function start() {
      window.clearInterval(timer);
      timer = window.setInterval(advance, INTERVAL_MS);
    }

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const next = Number(dot.dataset.slide || 0);
        goTo(next);
        start();
      });
    });

    start();
  }
</script>
