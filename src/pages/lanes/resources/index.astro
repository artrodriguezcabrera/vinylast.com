---
import LanesLayout from "../../../layouts/LanesLayout.astro";
import LanesPageHero from "../../../components/lanes/LanesPageHero.astro";
import LanesResourceCard from "../../../components/lanes/LanesResourceCard.astro";
import { getResources } from "../../../lib/contentful";
import { lanesHref } from "../../../lib/lanes";
import { resourceTypeLabels, resourceTypeOrder, type ResourceType } from "../../../lib/types";

const resources = await getResources();
const groups = resourceTypeOrder
  .map((type) => ({
    type,
    label: resourceTypeLabels[type as ResourceType],
    items: resources.filter((resource) => resource.type === type),
  }))
  .filter((group) => group.items.length > 0);
---

<LanesLayout
  title="Resources"
  description="Download Vinylast installation guides, spec sheets, warranties, catalogs, and videos."
  currentPath={lanesHref("/resources")}
>
  <LanesPageHero title="Resources" intro="Installation documents, test reports, catalogs, and videos." />

  <div class="main-wrapper">
    <div class="shop-area bg-color ptb--120 ptb_md--80 ptb_sm--80" data-bg-color="#ffffff">
      <div class="container">
        {
          resources.length === 0 ? (
            <div class="lanes-empty">
              <h2>No resources published yet</h2>
              <p>PDFs and videos will appear here after the next site build.</p>
            </div>
          ) : (
            groups.map((group) => (
              <section class="mb--80">
                <div class="section-title text-center">
                  <h2 class="title">{group.label}</h2>
                </div>
                <div class="row mt--20">
                  {group.items.map((resource) => (
                    <div class="col-lg-3 col-md-6 col-sm-6 col-12 mt--30">
                      <LanesResourceCard resource={resource} />
                    </div>
                  ))}
                </div>
              </section>
            ))
          )
        }
      </div>
    </div>
  </div>
</LanesLayout>
