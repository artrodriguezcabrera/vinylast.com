---
import Layout from "../../layouts/Layout.astro";
import ResourceCard from "../../components/ResourceCard.astro";
import { getProductBySlug, getProducts, youtubeEmbedUrl } from "../../lib/contentful";
import { resourceTypeLabels } from "../../lib/types";

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { slug: product.slug },
  }));
}

const { slug } = Astro.props;
const product = await getProductBySlug(slug);

if (!product) {
  return Astro.redirect("/products");
}

const thumbs = product.gallery.length ? product.gallery : product.hero ? [product.hero] : [];
const mockThumb = product.hero || thumbs[0];
const usingMockResources = product.relatedResources.length === 0;
const usingMockVideos = product.videos.length === 0;

const resources = usingMockResources
  ? [
      {
        id: "mock-install",
        title: `${product.name} installation guide`,
        slug: "sample-install",
        type: "install" as const,
        thumbnail: mockThumb,
        shortDescription: "Sample install sheet for this product. Replace with the published PDF.",
        relatedProducts: [],
      },
      {
        id: "mock-spec",
        title: `${product.name} spec sheet`,
        slug: "sample-spec",
        type: "spec" as const,
        thumbnail: mockThumb,
        shortDescription: "Sample dimensions, colors, and hardware list for quoting.",
        relatedProducts: [],
      },
      {
        id: "mock-warranty",
        title: "Vinylast limited warranty",
        slug: "sample-warranty",
        type: "warranty" as const,
        thumbnail: mockThumb,
        shortDescription: "Sample warranty language for the demo. Not a live document.",
        relatedProducts: [],
      },
    ]
  : product.relatedResources;

const videos = usingMockVideos
  ? [
      { title: `Installing ${product.name} — English (sample)`, url: mockThumb?.url || "" },
      { title: `Instalación de ${product.name} — Español (sample)`, url: mockThumb?.url || "" },
    ]
  : product.videos;
---

<Layout
  title={product.name}
  description={product.shortDescription || `${product.name} from Vinylast Inc.`}
  currentPath={`/products/${product.slug}`}
>
  <section class="section">
    <div class="wrap">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/products">Products</a>
        {
          product.category && (
            <>
              <span>/</span>
              <a href={`/products?category=${product.category.slug}`}>{product.category.name}</a>
            </>
          )
        }
        <span>/</span>
        <span>{product.name}</span>
      </nav>

      <div class:list={["product-layout", { "is-copy-only": thumbs.length === 0 }]}>
        <div>
          {
            thumbs.length > 0 && (
              <>
                <div class="gallery-main">
                  <img
                    id="gallery-image"
                    src={thumbs[0].url}
                    alt={thumbs[0].alt}
                    width={thumbs[0].width}
                    height={thumbs[0].height}
                  />
                </div>
                {thumbs.length > 1 && (
                  <div class="thumbs">
                    {thumbs.map((image, index) => (
                      <button type="button" data-src={image.url} data-alt={image.alt} aria-current={index === 0 ? "true" : undefined}>
                        <img src={image.url} alt="" width={image.width} height={image.height} />
                      </button>
                    ))}
                  </div>
                )}
              </>
            )
          }
        </div>
        <div class="product-copy">
          {(product.category || product.series) && (
            <p class="card-kicker">
              {[product.category?.name, product.series].filter(Boolean).join(" · ")}
            </p>
          )}
          <h1>{product.name}</h1>
          <p class="lede">{product.shortDescription}</p>
          <div class="btn-row" style="margin: 1.1rem 0 1.5rem">
            <a class="btn btn-primary" href="/contact">Contact us about this product</a>
            {product.relatedResources[0]?.file && (
              <a class="btn btn-outline" href={product.relatedResources[0].file.url}>
                Download spec
              </a>
            )}
          </div>
          {
            product.features.length > 0 && (
              <>
                <h2>Key features</h2>
                <ul class="feature-list">
                  {product.features.map((feature) => (
                    <li>{feature}</li>
                  ))}
                </ul>
              </>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="product-tabs">
        <div class="product-tabs-nav" role="tablist" aria-label="Product details">
          <button type="button" role="tab" id="tab-description" aria-controls="panel-description" aria-selected="true">
            Description
          </button>
          <button type="button" role="tab" id="tab-resources" aria-controls="panel-resources" aria-selected="false">
            Resources
          </button>
          <button type="button" role="tab" id="tab-videos" aria-controls="panel-videos" aria-selected="false">
            Videos
          </button>
        </div>

        <div
          class="product-tabs-panel"
          role="tabpanel"
          id="panel-description"
          aria-labelledby="tab-description"
        >
          {
            product.bodyHtml ? (
              <div class="prose">
                <Fragment set:html={product.bodyHtml} />
              </div>
            ) : (
              !product.specs.length && <p class="lede">{product.shortDescription}</p>
            )
          }
          {
            product.specs.length > 0 && (
              <table class="specs">
                <tbody>
                  {product.specs.map((spec) => (
                    <tr>
                      <th scope="row">{spec.name}</th>
                      <td>{spec.value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )
          }
        </div>

        <div
          class="product-tabs-panel"
          role="tabpanel"
          id="panel-resources"
          aria-labelledby="tab-resources"
          hidden
        >
          {usingMockResources && <p class="lede">Sample downloads for this demo. Live PDFs will replace these.</p>}
          <div class="cards">
            {
              usingMockResources
                ? resources.map((resource) => (
                    <a class="card" href="/contact">
                      {resource.thumbnail && (
                        <div class="card-media">
                          <img
                            src={resource.thumbnail.url}
                            alt=""
                            width={resource.thumbnail.width}
                            height={resource.thumbnail.height}
                          />
                        </div>
                      )}
                      <div class="card-body">
                        <p class="card-kicker">{resourceTypeLabels[resource.type]}</p>
                        <h3>{resource.title}</h3>
                        <p>{resource.shortDescription}</p>
                        <span class="card-link">Sample resource</span>
                      </div>
                    </a>
                  ))
                : product.relatedResources.map((resource) => <ResourceCard resource={resource} />)
            }
          </div>
        </div>

        <div
          class="product-tabs-panel"
          role="tabpanel"
          id="panel-videos"
          aria-labelledby="tab-videos"
          hidden
        >
          {usingMockVideos && <p class="lede">Sample videos for this demo. Published walkthroughs will replace these.</p>}
          <div class="video-grid">
            {
              usingMockVideos
                ? videos.map((video) => (
                    <div>
                      <div
                        class="video-frame mock-video"
                        style={video.url ? `background-image: url('${video.url}')` : undefined}
                        role="img"
                        aria-label={video.title}
                      >
                        <span class="mock-play" aria-hidden="true"></span>
                      </div>
                      <p style="margin-top: 0.5rem">{video.title}</p>
                    </div>
                  ))
                : product.videos.map((video) => (
                    <div>
                      <iframe
                        class="video-frame"
                        src={youtubeEmbedUrl(video.url)}
                        title={video.title}
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen
                      />
                      <p style="margin-top: 0.5rem">{video.title}</p>
                    </div>
                  ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const main = document.querySelector<HTMLImageElement>("#gallery-image");
  const buttons = document.querySelectorAll<HTMLButtonElement>(".thumbs button");
  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      if (!main) return;
      main.src = button.dataset.src || main.src;
      main.alt = button.dataset.alt || main.alt;
      buttons.forEach((item) => item.removeAttribute("aria-current"));
      button.setAttribute("aria-current", "true");
    });
  });

  const tabs = document.querySelectorAll<HTMLButtonElement>(".product-tabs-nav [role='tab']");
  const panels = document.querySelectorAll<HTMLElement>(".product-tabs-panel");

  function selectTab(next: HTMLButtonElement) {
    tabs.forEach((tab) => {
      const selected = tab === next;
      tab.setAttribute("aria-selected", selected ? "true" : "false");
    });
    panels.forEach((panel) => {
      panel.hidden = panel.id !== next.getAttribute("aria-controls");
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => selectTab(tab));
  });
</script>
