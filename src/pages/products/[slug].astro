---
import Layout from "../../layouts/Layout.astro";
import { getProductBySlug, getProducts, youtubeEmbedUrl } from "../../lib/contentful";
import { resourceThumbnail } from "../../lib/resource-documents";

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { slug: product.slug },
  }));
}

const { slug } = Astro.props;
const product = await getProductBySlug(slug);

if (!product) {
  return Astro.redirect("/products");
}

const thumbs = product.gallery.length ? product.gallery : product.hero ? [product.hero] : [];
const mockThumb = product.hero || thumbs[0];
const usingMockResources = product.relatedResources.length === 0;
const hasVideos = product.videos.length > 0;

const resourceCards = usingMockResources
  ? [
      {
        title: `${product.name} installation guide`,
        href: "/contact",
        image: mockThumb?.url,
        external: false,
        action: "Download PDF",
      },
      {
        title: `${product.name} spec sheet`,
        href: "/contact",
        image: mockThumb?.url,
        external: false,
        action: "Download PDF",
      },
      {
        title: "Vinylast limited warranty",
        href: "/contact",
        image: mockThumb?.url,
        external: false,
        action: "Download PDF",
      },
    ]
  : product.relatedResources.map((resource) => {
      const file = resource.file?.url;
      return {
        title: resource.title,
        href: file || `/resources/${resource.slug}`,
        image: resource.thumbnail?.url || (file?.startsWith("/documents/") ? resourceThumbnail(file) : undefined),
        external: Boolean(file),
        action: file ? "Download PDF" : "View resource",
      };
    });
---

<Layout
  title={product.name}
  description={product.shortDescription || `${product.name} from Vinylast Inc.`}
  currentPath={`/products/${product.slug}`}
>
  <section class="section">
    <div class="wrap">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/products">Products</a>
        {
          product.category && (
            <>
              <span>/</span>
              <a href={`/products?category=${product.category.slug}`}>{product.category.name}</a>
            </>
          )
        }
        <span>/</span>
        <span>{product.name}</span>
      </nav>

      <div class:list={["product-layout", { "is-copy-only": thumbs.length === 0 }]}>
        <div class="product-gallery-images">
          {
            thumbs.length > 0 && (
              <div class="product-gallery">
                {thumbs.length > 1 && (
                  <div class="thumbs">
                    {thumbs.map((image, index) => (
                      <button type="button" data-src={image.url} data-alt={image.alt} aria-current={index === 0 ? "true" : undefined}>
                        <img src={image.url} alt="" width={image.width} height={image.height} />
                      </button>
                    ))}
                  </div>
                )}
                <div class="gallery-main">
                  <img
                    id="gallery-image"
                    src={thumbs[0].url}
                    alt={thumbs[0].alt}
                    width={thumbs[0].width}
                    height={thumbs[0].height}
                  />
                </div>
              </div>
            )
          }
        </div>
        <div class="product-copy">
          <!--
          {(product.category || product.series) && (
            <p class="card-kicker">
              {[product.category?.name, product.series].filter(Boolean).join(" · ")}
            </p>
          )}
          -->
          <h1>{product.name}</h1>
          <p class="lede">{product.shortDescription}</p>
          <div class="btn-row" style="margin: 1.1rem 0 1.5rem">
            <a class="btn btn-primary" href="/contact">Contact us about this product</a>
            {product.relatedResources[0]?.file && (
              <a class="btn btn-outline" href={product.relatedResources[0].file.url}>
                Download spec
              </a>
            )}
          </div>
          {
            product.features.length > 0 && (
              <>
                <h2>Key features</h2>
                <ul class="feature-list">
                  {product.features.map((feature) => (
                    <li>{feature}</li>
                  ))}
                </ul>
              </>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="product-tabs">
        <div class="product-tabs-nav" role="tablist" aria-label="Product details">
          <button type="button" role="tab" id="tab-resources" aria-controls="panel-resources" aria-selected="true">
            Resources
          </button>
          <button type="button" role="tab" id="tab-description" aria-controls="panel-description" aria-selected="false">
            Other Details
          </button>
          {
            hasVideos && (
              <button type="button" role="tab" id="tab-videos" aria-controls="panel-videos" aria-selected="false">
                Videos
              </button>
            )
          }
        </div>

        <div
          class="product-tabs-panel"
          role="tabpanel"
          id="panel-resources"
          aria-labelledby="tab-resources"
        >
          {usingMockResources && <p class="lede">Sample downloads for this demo. Live PDFs will replace these.</p>}
          <div class="cards">
            {
              resourceCards.map((resource) => (
                <a
                  class="card"
                  href={resource.href}
                  target={resource.external ? "_blank" : undefined}
                  rel={resource.external ? "noopener noreferrer" : undefined}
                >
                  {
                    resource.image && (
                      <div class="card-media is-document">
                        <img src={resource.image} alt="" />
                      </div>
                    )
                  }
                  <div class="card-body">
                    <h3>{resource.title}</h3>
                    <span class="card-link card-action">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <path d="M12 3v12"></path>
                        <path d="m7 11 5 5 5-5"></path>
                        <path d="M5 21h14"></path>
                      </svg>
                      {resource.action}
                      {resource.external && <span class="visually-hidden"> (opens in a new tab)</span>}
                    </span>
                  </div>
                </a>
              ))
            }
          </div>
        </div>

        <div
          class="product-tabs-panel"
          role="tabpanel"
          id="panel-description"
          aria-labelledby="tab-description"
          hidden
        >
          {
            product.bodyHtml ? (
              <div class="prose">
                <Fragment set:html={product.bodyHtml} />
              </div>
            ) : (
              !product.specs.length && <p class="lede">{product.shortDescription}</p>
            )
          }
          {
            product.specs.length > 0 && (
              <table class="specs">
                <tbody>
                  {product.specs.map((spec) => (
                    <tr>
                      <th scope="row">{spec.name}</th>
                      <td>{spec.value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )
          }
        </div>

        {
          hasVideos && (
            <div
              class="product-tabs-panel"
              role="tabpanel"
              id="panel-videos"
              aria-labelledby="tab-videos"
              hidden
            >
              <div class="video-grid">
                {
                  product.videos.map((video) => (
                    <div>
                      <iframe
                        class="video-frame"
                        src={youtubeEmbedUrl(video.url)}
                        title={video.title}
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen
                      />
                      <p style="margin-top: 0.5rem">{video.title}</p>
                    </div>
                  ))
                }
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>
</Layout>

<script>
  const main = document.querySelector<HTMLImageElement>("#gallery-image");
  const buttons = document.querySelectorAll<HTMLButtonElement>(".thumbs button");
  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      if (!main) return;
      main.src = button.dataset.src || main.src;
      main.alt = button.dataset.alt || main.alt;
      buttons.forEach((item) => item.removeAttribute("aria-current"));
      button.setAttribute("aria-current", "true");
    });
  });

  const tabs = document.querySelectorAll<HTMLButtonElement>(".product-tabs-nav [role='tab']");
  const panels = document.querySelectorAll<HTMLElement>(".product-tabs-panel");

  function selectTab(next: HTMLButtonElement) {
    tabs.forEach((tab) => {
      const selected = tab === next;
      tab.setAttribute("aria-selected", selected ? "true" : "false");
    });
    panels.forEach((panel) => {
      panel.hidden = panel.id !== next.getAttribute("aria-controls");
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => selectTab(tab));
  });
</script>
